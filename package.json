{
  "name": "qmenux",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=24 <27",
    "pnpm": "10.29.2"
  },
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint && eslint eslint.config.mjs playwright.config.ts tests infrastructure/spikes/trace-api.mjs infrastructure/spikes/orm/probe.ts",
    "typecheck": "turbo run typecheck && tsc --project tsconfig.json",
    "test": "turbo run test && playwright test",
    "build": "turbo run build",
    "test:smoke": "playwright test",
    "spike:api-trace": "pnpm --filter @qmenux/api build && node infrastructure/spikes/trace-api.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@qmenux/config": "workspace:*",
    "@types/node": "24.19.2",
    "@vercel/nft": "1.11.0",
    "eslint": "9.39.5",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
