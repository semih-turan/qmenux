{
  "name": "@qmenux/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "migrations"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=../../.env dist/cli.js migrate",
    "rollback": "node --env-file-if-exists=../../.env dist/cli.js rollback",
    "seed": "node --env-file-if-exists=../../.env dist/cli.js seed"
  },
  "dependencies": { "pg": "^8.16.3", "@qmenux/contracts": "workspace:*" },
  "devDependencies": { "@qmenux/config": "workspace:*", "@types/pg": "^8.15.5", "@types/node": "^22.15.0", "vitest": "4.1.12" }
}
