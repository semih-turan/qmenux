# Local shells and API liveness run without secrets or database connections.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3003/v1

# Optional server-only API readiness. Set locally; never use NEXT_PUBLIC_ or an owner URL.
# Runtime role: qmenux_runtime; Neon pooled endpoint; sslmode=verify-full&channel_binding=require.
DATABASE_URL=

# Server-only Google OIDC development. Disabled until provider/security/privacy review.
AUTH_GOOGLE_ENABLED=false
# Exact API origin, never a browser-supplied redirect or shared parent-domain cookie.
AUTH_BASE_URL=https://qmenux-api.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only operator Access verification; disabled until reviewed Access/IdP setup.
# Dedicated operator application AUD, never the tenant app or Google client ID.
OPERATOR_ACCESS_ENABLED=false
OPERATOR_ACCESS_ISSUER=
OPERATOR_ACCESS_AUDIENCE=

# API-only passkey prerequisite; keep off until reviewed privileged transport/enrollment/recovery.
# Adds no HTTP route or operator and never replaces the required Access gate.
OPERATOR_PASSKEY_ENABLED=false

# API-only maintenance bearer secret: 32 random bytes encoded as 43 base64url characters.
# Empty disables the endpoint. Never NEXT_PUBLIC_, Preview or a URL/query parameter.
CRON_SECRET=

# Server-only Microsoft personal-account OIDC. Keep disabled until provider/security/privacy review.
AUTH_MICROSOFT_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Server-only Apple confidential nonce development profile. Keep disabled until provider/security/privacy review.
# PKCS#8 P-256 PEM uses actual newlines; never commit/upload a real key to frontend/Preview.
AUTH_APPLE_ENABLED=false
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_PRIVATE_KEY=

# Dedicated API/admin-server BFF credential; empty keeps internal admin auth unavailable.
# Never reuse CRON_SECRET or an IdP key; never NEXT_PUBLIC_, build config or Preview.
ADMIN_BFF_SECRET=

# Admin Next.js server only. Explicit opt-in after provider/security/privacy review.
# Requires independent ADMIN_BFF_SECRET runtime binding on admin and API; canonical hosts only.
ADMIN_AUTH_ENABLED=false

# Dedicated API/admin-server application transport; opt-in only after privacy/security review.
# Never reuse the sign-in or maintenance key; no NEXT_PUBLIC_, build or Preview binding.
ADMIN_ONBOARDING_ENABLED=false
ADMIN_ONBOARDING_SECRET=
