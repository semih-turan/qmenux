# Local development only. Copy to .env; never commit real keys.
# Use separate credentials and approved provider settings for preview/production.
QX_ROOT_DOMAIN=qmenux.localhost
QX_API_ORIGIN=http://api.qmenux.localhost:4000
QX_API_INTERNAL_ORIGIN=http://127.0.0.1:4000
QX_ADMIN_ORIGIN=http://admin.qmenux.localhost:3001
QX_OPS_ORIGIN=http://superman.qmenux.localhost:3002
QX_LANDING_ORIGIN=http://qmenux.localhost:3003

# Local PostgreSQL from pnpm db:start. Production runtime uses Neon pooled URLs;
# migrations use a separate direct connection. Never run seed/tests on production.
DATABASE_URL=postgres://postgres@127.0.0.1:54329/qmenux_dev
DATABASE_DIRECT_URL=postgres://postgres@127.0.0.1:54329/qmenux_dev
QX_TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/qmenux_test
QX_API_TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/qmenux_api_test

# Generate EACH key independently: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# API only: token hashing and encrypted data. BFF key: API + Next.js servers only.
QX_TOKEN_PEPPER=
QX_DATA_KEY=
QX_BFF_SHARED_KEY=

# Optional local mock IdP. Production refuses QX_DEV_IDP=1.
QX_DEV_IDP=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=consumers
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Use the SAME absolute local media directory for API and external worker.
# Empty uses per-app defaults. Production R2 driver is not implemented yet.
QX_MEDIA_DIR=
R2_PUBLIC_BASE_URL=

# Optional restricted Vercel PREVIEW only (never production/browser).
# Menu mapping is limited to the platform-provided VERCEL_URL.
QX_PREVIEW_MENU_SLUG=
QX_API_PROTECTION_BYPASS=
