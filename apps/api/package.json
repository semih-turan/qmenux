{
  "name": "@qmenux/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "dev": "node --watch --env-file-if-exists=../../.env dist/main.js",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "ops:totp": "node --env-file-if-exists=../../.env dist/cli/ops-totp.js"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@qmenux/contracts": "workspace:*",
    "@qmenux/database": "workspace:*",
    "exceljs": "^4.4.0",
    "express": "^5",
    "jose": "^6.2.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@qmenux/config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "vitest": "4.1.12"
  }
}
