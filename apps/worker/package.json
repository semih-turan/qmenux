{
  "name": "@qmenux/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "node --watch --env-file-if-exists=../../.env dist/main.js"
  },
  "dependencies": {
    "@qmenux/contracts": "workspace:*",
    "@qmenux/database": "workspace:*",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.13.9",
    "typescript": "~5.9.3",
    "vitest": "4.1.12",
    "@types/pg": "^8.15.5",
    "@qmenux/config": "workspace:*"
  }
}
